{
  "schemaVersion": 1,
  "runtimePaths": [
    "app.js",
    "index.html",
    "styles.css",
    "sw.js",
    "marked.min.js",
    "manifest.webmanifest",
    "assets/",
    "src/"
  ],
  "baseline": [
    "action-registry-core"
  ],
  "finalBaseline": [
    "sw-integration",
    "v50",
    "v59",
    "v67",
    "v70",
    "v72",
    "v105",
    "v136",
    "xss-sanitizer"
  ],
  "areas": {
    "legacy-app": {
      "paths": [
        "^app\\.js$"
      ],
      "suites": [
        "action-registry-core", "track-crud-core"
      ]
    },
    "navigation-view": {
      "patterns": [
        "currentView|selectedDate|defaultView|renderMain|showView|date-(?:prev|next)|data-action=[\"'](?:nav|set-date)"
      ],
      "suites": [
        "today-core",
        "v57",
        "v75",
        "v134",
        "v140",
        "v143"
      ]
    },
    "wish-feature": {
      "paths": [
        "^src/features/wish"
      ],
      "patterns": [
        "renderWish|saveWish|deleteWish|realizeWish|wishProject|wishOpen"
      ],
      "suites": [
        "wish-core"
      ]
    },
    "journal-feature": {
      "paths": [
        "^src/features/journal"
      ],
      "patterns": [
        "renderJournal|saveJournal|journalEntry|conditionLog|storeVisit|gymRecord"
      ],
      "suites": [
        "journal-core",
        "v141"
      ]
    },
    "today-feature": {
      "paths": [
        "^src/features/(?:today(?:-tower)?|coach)\\.js$"
      ],
      "patterns": [
        "renderToday|renderTodayTower|towerFlights|todaySkin|coachSummaryForDate|QUICK_MEALS"
      ],
      "suites": [
        "today-core",
        "tower-core",
        "tower-model-core",
        "coach-core"
      ]
    },
    "action-dispatch": {
      "paths": [
        "^src/ui/actions"
      ],
      "suites": [
        "action-registry-core"
      ]
    },
    "sync-storage": {
      "paths": [
        "^src/(?:sync/|storage/|core/merge)"
      ],
      "patterns": [
        "^[+-].*saveState|sync|github|pushState|pullState|mergeById|dataModifiedAt|updatedAt"
      ],
      "suites": [
        "merge-core",
        "store-core",
        "v72",
        "v118",
        "v134",
        "v135",
        "v136"
      ]
    },
    "state-migration": {
      "paths": [
        "^src/state/"
      ],
      "patterns": [
        "normalizeState|seedState|setState|migration|migrat"
      ],
      "suites": [
        "store-core",
        "v67",
        "v105",
        "v135",
        "v136"
      ]
    },
    "timeline-execution": {
      "paths": [
        "^src/features/timeline"
      ],
      "patterns": [
        "renderTimeline|timeline|pomodoro|scheduleDraft|now-line"
      ],
      "suites": [
        "timeline-layout-core",
        "timeline-render-core",
        "today-core",
        "v50",
        "v70"
      ]
    },
    "responsive-theme": {
      "paths": [
        "^(?:styles\\.css|index\\.html)$"
      ],
      "patterns": [
        "data-theme|resolveTheme|viewport|@media|responsive"
      ],
      "suites": [
        "today-core",
        "v123",
        "v127",
        "v151"
      ]
    },
    "security-offline": {
      "paths": [
        "^(?:sw\\.js|marked\\.min\\.js|manifest\\.webmanifest|assets/)"
      ],
      "patterns": [
        "APP_SHELL|CACHE_NAME|serviceWorker|innerHTML|escapeHtml|sanitize"
      ],
      "suites": [
        "sw-integration",
        "sw-self-heal",
        "v140",
        "xss-sanitizer"
      ]
    },
    "recurrence-engine": {
      "paths": [
        "^src/core/recurrence"
      ],
      "patterns": [
        "maintainRecurrences|createRecurrenceRule|triggerAnchorPlacements|recurrenceMatchesDate|makeRecurrenceInstance|anchorCandidateOptions|routineRate"
      ],
      "suites": [
        "recurrence-core"
      ]
    },
    "track-core": {
      "paths": [
        "^src/core/track"
      ],
      "patterns": [
        "weeklyScore|paceNumeric|paceMilestone|trackStatus|forwardTracksForWeek|selectTrackFooter|activeTrackForProject|latestMeasurement"
      ],
      "suites": [
        "track-core"
      ]
    }
  }
}
