{
  "schemaVersion": 1,
  "runtimePaths": [
    "app.js",
    "index.html",
    "styles.css",
    "sw.js",
    "marked.min.js",
    "manifest.webmanifest",
    "assets/",
    "src/"
  ],
  "baseline": [
    "action-registry-core"
  ],
  "finalBaseline": [
    "sw-integration",
    "v50",
    "v59",
    "v67",
    "v70",
    "v72",
    "v105",
    "v136",
    "v255",
    "v262",
    "v266",
    "xss-sanitizer"
  ],
  "areas": {
    "legacy-app": {
      "paths": [
        "^app\\.js$"
      ],
      "suites": [
        "action-registry-core",
        "track-crud-core"
      ]
    },
    "navigation-view": {
      "patterns": [
        "currentView|selectedDate|defaultView|renderMain|showView|date-(?:prev|next)|data-action=[\"'](?:nav|set-date)"
      ],
      "suites": [
        "today-core",
        "v57",
        "v75",
        "v134",
        "v140",
        "v143"
      ]
    },
    "wish-feature": {
      "paths": [
        "^src/features/wish"
      ],
      "patterns": [
        "renderWish|saveWish|deleteWish|realizeWish|wishProject|wishOpen"
      ],
      "suites": [
        "wish-core"
      ]
    },
    "fund-feature": {
      "paths": [
        "^src/(?:features/fund|state/fund-cache)\\.js$"
      ],
      "patterns": [
        "renderFund|hydrateFundData|dashboard/fund\\.json|data-view=[\"']fund"
      ],
      "suites": [
        "v82",
        "v148",
        "v281"
      ]
    },
    "journal-feature": {
      "paths": [
        "^src/features/journal"
      ],
      "patterns": [
        "renderJournal|saveJournal|journalEntry|conditionLog|storeVisit|gymRecord"
      ],
      "suites": [
        "journal-core",
        "v141"
      ]
    },
    "today-feature": {
      "paths": [
        "^src/features/(?:today(?:-tower)?|coach)\\.js$"
      ],
      "patterns": [
        "renderToday|renderTodayTower|towerFlights|todaySkin|QUICK_MEALS"
      ],
      "suites": [
        "today-core",
        "tower-core",
        "tower-model-core",
        "coach-core"
      ]
    },
    "action-dispatch": {
      "paths": [
        "^src/ui/actions"
      ],
      "suites": [
        "action-registry-core"
      ]
    },
    "sync-storage": {
      "paths": [
        "^src/(?:sync/|storage/|core/merge)"
      ],
      "patterns": [
        "^[+-].*saveState|sync|github|pushState|pullState|mergeById|dataModifiedAt|updatedAt"
      ],
      "suites": [
        "merge-core",
        "store-core",
        "v72",
        "v118",
        "v134",
        "v135",
        "v136"
      ]
    },
    "state-migration": {
      "paths": [
        "^src/state/"
      ],
      "patterns": [
        "normalizeState|seedState|setState|migration|migrat"
      ],
      "suites": [
        "store-core",
        "v67",
        "v105",
        "v135",
        "v136"
      ]
    },
    "timeline-execution": {
      "paths": [
        "^src/features/timeline"
      ],
      "patterns": [
        "renderTimeline|timeline|pomodoro|scheduleDraft|now-line"
      ],
      "suites": [
        "timeline-layout-core",
        "timeline-render-core",
        "today-core",
        "v50",
        "v70"
      ]
    },
    "responsive-theme": {
      "paths": [
        "^(?:styles\\.css|index\\.html)$"
      ],
      "patterns": [
        "data-theme|resolveTheme|viewport|@media|responsive"
      ],
      "suites": [
        "today-core",
        "v123",
        "v127",
        "v151"
      ]
    },
    "security-offline": {
      "paths": [
        "^(?:sw\\.js|marked\\.min\\.js|manifest\\.webmanifest|assets/)"
      ],
      "patterns": [
        "APP_SHELL|CACHE_NAME|serviceWorker|innerHTML|escapeHtml|sanitize"
      ],
      "suites": [
        "sw-integration",
        "sw-self-heal",
        "v140",
        "xss-sanitizer"
      ]
    },
    "recurrence-engine": {
      "paths": [
        "^src/core/recurrence"
      ],
      "patterns": [
        "maintainRecurrences|createRecurrenceRule|triggerAnchorPlacements|recurrenceMatchesDate|makeRecurrenceInstance|anchorCandidateOptions|routineRate"
      ],
      "suites": [
        "recurrence-core"
      ]
    },
    "track-core": {
      "paths": [
        "^src/core/track"
      ],
      "patterns": [
        "weeklyScore|paceNumeric|paceMilestone|milestoneProgressRatio|normalizeMilestoneProgress|trackStatus|forwardTracksForWeek|selectTrackFooter|activeTrackForProject|latestMeasurement"
      ],
      "suites": [
        "track-core"
      ]
    },
    "habit-streak-core": {
      "paths": [
        "^src/core/habit-streak\\.js$"
      ],
      "suites": [
        "instruments-core",
        "v252",
        "v253",
        "v280"
      ]
    },
    "life-export-core-feature": {
      "paths": [
        "^src/core/life-export\\.js$"
      ],
      "suites": [
        "life-export-core",
        "v316"
      ]
    },
    "today-model-core": {
      "paths": [
        "^src/core/today-model\\.js$"
      ],
      "suites": [
        "tower-model-core"
      ]
    },
    "health-feature": {
      "paths": [
        "^src/features/health\\.js$"
      ],
      "suites": [
        "v314",
        "v317",
        "v318",
        "v321",
        "v325",
        "v327",
        "instruments-core",
        "v326"
      ]
    },
    "instruments-feature": {
      "paths": [
        "^src/features/instruments\\.js$"
      ],
      "suites": [
        "instruments-core",
        "instruments-e2e",
        "v247",
        "v284",
        "v326",
        "v327"
      ]
    },
    "iron-log-feature": {
      "paths": [
        "^src/features/iron-log\\.js$"
      ],
      "suites": [
        "iron-log-core",
        "iron-log-e2e",
        "v284",
        "v315"
      ]
    },
    "topband-feature": {
      "paths": [
        "^src/features/topband\\.js$"
      ],
      "suites": [
        "topband-core",
        "v231",
        "v266",
        "v275"
      ]
    },
    "track-ui-feature": {
      "paths": [
        "^src/features/track-ui\\.js$"
      ],
      "suites": [
        "action-registry-core",
        "v254",
        "v262",
        "v267"
      ]
    }
  }
}
