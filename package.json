{
  "name": "taskchute-journal-pwa",
  "version": "53.0.0",
  "private": true,
  "description": "TaskChute Journal PWA(実行時依存ゼロ。devDependenciesはテスト・索引用のみ)",
  "scripts": {
    "dev": "node tests/serve.js",
    "test": "node tests/run-all.js",
    "test:manifest": "node scripts/test-manifest.js --check",
    "test:manifest:write": "node scripts/test-manifest.js --write",
    "code:index": "node scripts/code-index.js --check",
    "code:index:write": "node scripts/code-index.js --write",
    "test:fast": "node tests/run-all.js --group=fast-node --workers=2",
    "test:e2e": "node tests/run-all.js --group=domain-e2e",
    "test:smoke": "node tests/run-all.js --group=smoke",
    "test:quick": "node tests/run-all.js",
    "test:core": "node tests/run-core.js"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "playwright-core": "^1.61.1"
  }
}
